{
  "name": "@statewalker/merge-core",
  "version": "0.1.1",
  "description": "Domain-neutral three-way merge/diff engine over the webrun-files FilesApi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/statewalker/webrun-vcs.git",
    "directory": "packages/merge-core"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc --emitDeclarationOnly --declaration",
    "test": "vitest run",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome check --write --unsafe .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/webrun-files": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "catalog:",
    "rolldown": "catalog:",
    "vitest": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
